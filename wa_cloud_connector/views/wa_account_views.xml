<odoo>
    <record id="wa_account_view_list" model="ir.ui.view">
        <field name="name">wa.account.list</field>
        <field name="model">wa.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="display_phone_number"/>
                <field name="phone_number_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="connection_state" widget="badge"
                       decoration-success="connection_state == 'ok'"
                       decoration-danger="connection_state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="wa_account_view_form" model="ir.ui.view">
        <field name="name">wa.account.form</field>
        <field name="model">wa.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary"/>
                    <button name="action_sync_templates" type="object" string="Sync Templates"/>
                    <field name="connection_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_templates" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="template_count" widget="statinfo" string="Templates"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales WhatsApp"/></h1>
                    </div>
                    <group>
                        <group string="Meta Identifiers">
                            <field name="phone_number_id"/>
                            <field name="waba_id"/>
                            <field name="api_version"/>
                        </group>
                        <group string="Business Number">
                            <field name="display_phone_number"/>
                            <field name="verified_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="create_unknown_partner"/>
                        </group>
                    </group>
                    <group string="Credentials" groups="base.group_system">
                        <group>
                            <field name="access_token" password="True"/>
                            <field name="app_secret" password="True"/>
                        </group>
                        <group>
                            <field name="webhook_url" widget="CopyClipboardChar"/>
                            <label for="webhook_verify_token"/>
                            <div class="o_row">
                                <field name="webhook_verify_token" widget="CopyClipboardChar"/>
                                <button name="action_regenerate_verify_token" type="object"
                                        icon="fa-refresh" title="Generate a new token"
                                        class="btn-link"/>
                            </div>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" groups="base.group_system">
                        In your Meta app, open <b>WhatsApp &gt; Configuration</b>, paste the
                        callback URL and verify token above, then subscribe to the
                        <code>messages</code> webhook field.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wa_account_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">wa.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your first WhatsApp Business number</p>
            <p>You need the phone number ID, WhatsApp Business Account ID and a permanent
               access token from your Meta developer app.</p>
        </field>
    </record>
</odoo>
