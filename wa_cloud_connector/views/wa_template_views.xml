<odoo>
    <record id="wa_template_view_list" model="ir.ui.view">
        <field name="name">wa.template.list</field>
        <field name="model">wa.template</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="language"/>
                <field name="category"/>
                <field name="model_id" optional="show"/>
                <field name="placeholder_count" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status in ('pending', 'paused')"
                       decoration-danger="status in ('rejected', 'disabled')"/>
            </list>
        </field>
    </record>

    <record id="wa_template_view_form" model="ir.ui.view">
        <field name="name">wa.template.form</field>
        <field name="model">wa.template</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="language"/>
                            <field name="category"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="meta_id"/>
                            <field name="placeholder_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <group>
                                <field name="header_text" invisible="not header_text"/>
                                <field name="body"/>
                                <field name="footer_text" invisible="not footer_text"/>
                            </group>
                        </page>
                        <page string="Placeholders" name="placeholders"
                              invisible="not placeholder_count">
                            <p class="text-muted">
                                Map each <code>{{n}}</code> to a field path evaluated on the
                                document, e.g. <code>partner_id.name</code> or
                                <code>amount_total</code>. Users can still edit the values
                                before sending.
                            </p>
                            <field name="variable_ids">
                                <list editable="bottom">
                                    <field name="position"/>
                                    <field name="field_path"/>
                                    <field name="default_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wa_template_view_search" model="ir.ui.view">
        <field name="name">wa.template.search</field>
        <field name="model">wa.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="body"/>
                <filter name="approved" string="Approved" domain="[('status', '=', 'approved')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="wa_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">wa.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No templates yet</p>
            <p>Templates are created and approved in Meta, then pulled in with
               <b>Sync Templates</b> on the WhatsApp account.</p>
        </field>
    </record>
</odoo>
