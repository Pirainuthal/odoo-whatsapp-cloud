<odoo>
    <record id="res_groups_privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_wa_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can send WhatsApp messages from documents and read the message log.</field>
    </record>

    <record id="group_wa_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_wa_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Can configure accounts, synchronise templates and map placeholders.</field>
    </record>

    <record id="wa_account_company_rule" model="ir.rule">
        <field name="name">WhatsApp account: multi-company</field>
        <field name="model_id" ref="model_wa_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="wa_template_company_rule" model="ir.rule">
        <field name="name">WhatsApp template: multi-company</field>
        <field name="model_id" ref="model_wa_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="wa_message_company_rule" model="ir.rule">
        <field name="name">WhatsApp message: multi-company</field>
        <field name="model_id" ref="model_wa_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
